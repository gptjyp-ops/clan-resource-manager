{
  "name": "clan-vault",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/prepare-ocr.mjs && vite build",
    "check": "tsc --noEmit",
    "preview": "vite preview",
    "deploy:worker": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply clan-vault-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply clan-vault-db --remote"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/kor": "^1.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.31.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}
